# Copy to .env and fill in. Local development reads it from the repo root; production passes it to docker compose.

# Telegram
BOT_TOKEN=
BOT_USERNAME=
BOT_WEBHOOK_SECRET=         # prod: any random string, e.g. `openssl rand -hex 32`
BOT_MODE=polling            # dev only: polling | webhook (production compose always uses webhook)
PUBLIC_URL=                 # dev only: webhook base; in production it is https://DOMAIN
MINIAPP_URL=                # dev only: tunnel address for the menu button; in production it is https://DOMAIN

# Groq (STT + LLM)
GROQ_API_KEY=

# Auth
JWT_SECRET=                 # >= 32 random chars, e.g. `openssl rand -hex 32`

# Database
POSTGRES_PASSWORD=debits    # prod: a long random one, set before the first start and never change afterwards

# Deploy (production only, see deploy/README.md)
DOMAIN=                     # debits.example.com, its A record must point to the server
BACKUP_CHAT_ID=             # Telegram user id that receives the daily database dump (optional)
BACKUP_HOUR=3               # local hour of the daily dump
BACKUP_KEEP_DAYS=14         # dumps older than this are deleted from the server

# Optional self-hosted Uzbek speech model. Uncomment to start the stt container; without it Groq does all recognition.
#COMPOSE_PROFILES=stt
#STT_MODEL=yuldashev222/uzbek_stt_v1-ct2
